{
  "cleanUrls": false,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/(css|js)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/services/mold-air-testing.html",
      "destination": "/services/mold-remediation.html",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/privacy-policy",
      "destination": "/privacy-policy.html"
    },
    {
      "source": "/privacy-policy/",
      "destination": "/privacy-policy.html"
    },
    {
      "source": "/leave-a-review",
      "destination": "/leave-a-review.html"
    },
    {
      "source": "/leave-a-review/",
      "destination": "/leave-a-review.html"
    }
  ]
}
